@charset "utf-8";

@import url("https://fonts.googleapis.com/css?family=3DGoogle+Sans");

@import url("https://fonts.googleapis.com/css?family=3DRoboto");

body { font-family: Roboto, arial, sans, sans-serif; margin: 0px; }

iframe { border: 0px; height: 100%; width: 100%; }

#banners { align-items: center; background: white; display: block; justify-=
content: space-between; position: fixed; top: 0px; width: 100%; z-index: 10=
0; }

#banners #publish-banner { background-color: rgb(232, 240, 254); border-bot=
